; -------------------------------------------------------------------------
; PrismRTG - Installer script
; RTG (graphics card) software for AmigaOS 3.x:
;   MNT ZZ9000, the Z3660's RTG output, the Picasso II family (GBAPII++,
;   Piccolo, Spectrum, Graffity) and the Picasso IV; also UAE's RTG card in an
;   emulator, and other cards through their own Picasso96 driver.
; Needs the standard Installer, Kickstart 3.1 or newer and a 68020 or better.
; Double-click Install_PrismRTG, or from a Shell in this drawer:
;     Installer Install_PrismRTG
; Run it again to update PrismRTG or to remove it.
;
; The product is PrismRTG; its files keep their short names (PrismD, PrismPrefs,
; the monitor file "Prism", the PRISM: screen modes).
; -------------------------------------------------------------------------
(set @app-name "PrismRTG")
(complete 0)

; ---- the machine ---------------------------------------------------------
(if (< (/ (getversion "graphics.library" (resident)) 65536) 40)
    (abort "PrismRTG needs Kickstart 3.1 or newer (graphics.library 40)."))
(set cpu (database "cpu"))
(if (or (= cpu "68000") (= cpu "68010"))
    (abort "PrismRTG needs a 68020 or better processor (this Amiga has a " cpu ")."))
(if (or (not (exists "PrismD")) (not (exists "Drivers/PICASSO2.driver")))
    (abort "Can't find PrismD next to this script.\n\n"
           "Run the installer from the drawer it came in."))

(set mon   "DEVS:Monitors")
(set store "SYS:Storage/Monitors")
(set smode "ENVARC:Sys/screenmode.prefs")
(set sback "ENVARC:Sys/screenmode.prefs.before-prism")
(set pnote "ENVARC:Prism.p96monitor")      ; name of the Picasso96 monitor we moved away
(set plib  "LIBS:Picasso96API.library")
(set pkeep "LIBS:Picasso96API.library.before-prism")   ; Picasso96's own, kept aside

; ---- which card (PrismSetup looks; it changes nothing) -------------------
(run "PrismSetup >NIL: DETECT")
(set card    (getenv "PrismCard"))
(set cardname (getenv "PrismCardName"))
(set p96mon  (getenv "PrismP96Mon"))
(set p96n    (getenv "PrismP96"))          ; pieces of an installed Picasso96 (0 = none)
(set p96list (getenv "PrismP96List"))
(set p96left 0)                            ; 1 = Picasso96 stays in place

; In NOVICE mode the Installer answers every question itself with its
; default (Update, back Picasso96 up, 800x600): the icon says MINUSER=AVERAGE,
; and a Shell start without it stops here rather than decide for the user.
(if (= @user-level 0)
    (abort "Please start this installer from its icon, or from a Shell with\n\n"
           "   Installer Install_PrismRTG MINUSER AVERAGE\n\n"
           "It asks what to do about an installed PrismRTG, an installed "
           "Picasso96 and the Workbench screen; a Novice installation would "
           "answer those by itself."))

; ---- install, update or remove -------------------------------------------
(set mode 0)
(set wipe 0)
(set fresh (not (exists (tackon mon "Prism"))))   ; a first install, not an update
(if (not fresh)
    (set mode
        (askchoice
            (prompt "PrismRTG is installed on this Amiga. What should the installer do?")
            (help "Update copies this package's programs over the installed ones. "
                  "Your settings (Prefs/PrismPrefs, the Workbench screen) are kept.\n\n"
                  "Install afresh copies the programs and starts the settings over: "
                  "PrismPrefs' defaults, and the Workbench screen question again.\n\n"
                  "Remove deletes PrismRTG, puts the Workbench screen mode back the way "
                  "it was before, and moves Picasso96 back out of its backup drawer "
                  "(SYS:Storage/Picasso96-parked) if the installer put it there.")
            (choices "Update PrismRTG, keep my settings"
                     "Install afresh, new settings"
                     "Remove PrismRTG")
            (default 0))))

; afresh: the settings go, and the rest of the install runs as a first one
(if (= mode 1)
    (
        (set wipe 1)              ; the settings go when the programs are copied,
        (set fresh 1)             ; not before a question the user may still abort
    ))

(if (= mode 2)
    (
        ; our Picasso96API.library file goes first (only ours: it is tiny), so
        ; that Picasso96's own can come back to its place
        (if (exists plib)
            (if (< (getsize plib) 2000)
                (run (cat "Delete >NIL: \"" plib "\" QUIET"))))
        ; Picasso96 back out of the backup drawer, while PrismSetup is still there
        ; (not "back": that is an Installer parameter name, and the OS 3.9 Installer
        ; 44.10 refused the whole script for it - seen on Caffeine OS)
        (set p96msg "")
        (if (exists "SYS:Storage/Picasso96-parked/Prism.manifest")
            (
                (if (exists "C:PrismSetup")
                    (run "C:PrismSetup >NIL: P96RESTORE")
                    (run "PrismSetup >NIL: P96RESTORE"))
                (if (exists "SYS:Storage/Picasso96-parked/Prism.manifest")
                    (set p96msg (cat "\n\nSome of Picasso96 could not be moved back and is still "
                                   "in SYS:Storage/Picasso96-parked."))
                    (set p96msg "\n\nPicasso96 is back where it was."))
            ))
        ; the block an install put in a Startup-Sequence whose LoadMonDrvs names
        ; its monitors (Caffeine OS), while PrismSetup is still there
        (if (exists "C:PrismSetup")
            (run "C:PrismSetup >NIL: STARTUP=REMOVE"))
        ; (run takes ONE string: several are not joined - always (cat ...) the command)
        (run (cat "Delete >NIL: C:PrismD C:PrismSetup C:PrismProbe C:PrismUpdate C:PrismImport \"" (tackon mon "Prism")
                  "\" \"" (tackon mon "Prism.info") "\" QUIET"))
        (run "Delete >NIL: LIBS:Prism/PICASSO2.driver LIBS:Prism/ZZ9000.driver LIBS:Prism/Z3660.driver LIBS:Prism/P96.driver LIBS:Prism/UAEGFX.driver QUIET")
        (run "Delete >NIL: LIBS:Prism QUIET")
        (run "Delete >NIL: SYS:Prefs/PrismPrefs SYS:Prefs/PrismPrefs.info QUIET")
        (run "Delete >NIL: ENVARC:Prism.prefs ENV:Prism.prefs ENVARC:Prism.booting QUIET")
        (if (and (exists pkeep) (not (exists plib)))
            (run (cat "Rename >NIL: \"" pkeep "\" \"" plib "\"")))
        (if (exists sback)
            (
                (run (cat "Copy >NIL: \"" sback "\" \"" smode "\" CLONE"))
                (run (cat "Delete >NIL: \"" sback "\" QUIET"))
            ))
        ; Caffeine OS keeps a screen mode per machine next to it (PrismSetup kept each)
        (foreach "ENVARC:Sys" "screenmode.prefs.#?.before-prism"
            (
                (set kept (tackon "ENVARC:Sys" @each-name))
                (set was (substr kept 0 (- (strlen kept) 13)))      ; less ".before-prism"
                (run (cat "Copy >NIL: \"" kept "\" \"" was "\" CLONE"))
                (run (cat "Delete >NIL: \"" kept "\" QUIET"))
            ))
        ; (a monitor file moved away by an older version of this installer)
        (if (exists pnote)
            (
                ; make sure ENV: has it (it is only a copy of ENVARC: made at boot)
                (run (cat "Copy >NIL: \"" pnote "\" ENV:Prism.p96monitor"))
                (set old (getenv "Prism.p96monitor"))
                (if (exists (tackon store old))
                    (
                        (run (cat "Rename >NIL: \"" (tackon store old) "\" \"" (tackon mon old) "\""))
                        (if (exists (tackon store (cat old ".info")))
                            (run (cat "Rename >NIL: \"" (tackon store (cat old ".info")) "\" \""
                                      (tackon mon (cat old ".info")) "\"")))
                        (set p96msg (cat "\n\nThe Picasso96 monitor \"" old "\" is back in " mon "."))
                    ))
                (run (cat "Delete >NIL: \"" pnote "\" ENV:Prism.p96monitor QUIET"))
            ))
        (exit "PrismRTG is removed." p96msg "\n\n"
              "Reboot now: PrismRTG keeps running until then." (quiet))
    ))

; ---- a first install: say what it is, and check the card -----------------
(if fresh
    (message "Welcome to PrismRTG.\n\n"
             "PrismRTG is graphics card software for the MNT ZZ9000, the Z3660, the "
             "GBAPII++ and Picasso II family and the Picasso IV - and for UAE's RTG "
             "card and other cards through their own Picasso96 driver: Workbench and "
             "programs in 256 colours, 16-bit and 24/32-bit, with its own "
             "cybergraphics.library and Picasso96API.library.\n\n"
             "It takes the place of Picasso96: the two cannot be active on the same "
             "Amiga. If Picasso96 is installed, the installer asks before it touches "
             "anything, and nothing of Picasso96 is ever deleted."))

(if (= card "0")
    (if (not (askbool
            (prompt "No graphics card that PrismRTG knows was found in this Amiga.\n\n"
                    "PrismRTG drives the MNT ZZ9000, the Z3660's RTG output, the "
                    "Picasso II, GBAPII++, Piccolo, Piccolo SD64, Spectrum 28/24, "
                    "Graffity and Picasso IV, UAE's RTG card in an emulator, and other "
                    "cards through their Picasso96 driver (when a monitor in "
                    "DEVS:Monitors names one that is in LIBS:Picasso96).\n\n"
                    "Install it anyway?")
            (help "Without one of these cards PrismRTG starts, finds nothing and stops: "
                  "the Amiga works as before. Installing anyway only makes sense if the "
                  "card will be fitted later.")
            (choices "Install anyway" "Cancel")
            (default 0)))
        (exit "Nothing was installed." (quiet))))
(if (or (= card "1") (= card "5") (= card "6") (= card "7") (= card "8") (= card "10"))
    (message "PrismRTG has been tested on this kind of card (" cardname ") only in an "
             "emulator, never on the real hardware.\n\n"
             "It may work, or the picture may be wrong. Picasso96 is not touched "
             "unless you say so, and holding the left mouse button while booting "
             "always starts the Amiga without PrismRTG."))
(if (= card "11")
    (message "This Amiga is an emulator with UAE's RTG card.\n\n"
             "PrismRTG drives it directly; Picasso96 is not needed for it."))
; a true-colour Workbench (Caffeine OS's backdrops and icons) on these: 16-bit
(set wbdef 1)
(if (or (= card "11") (= card "12")) (set wbdef 2))
(if (= card "12")
    (message "PrismRTG will drive this card (" cardname ") through its own Picasso96 "
             "driver, " (getenv "PrismP96Card") ".\n\n"
             "That driver stays where it is. PrismRTG has been tested this way with UAE's "
             "card, not with this one: it may work, or the picture may be wrong. Holding "
             "the left mouse button while booting always starts the Amiga without "
             "PrismRTG, and running this installer again removes it."))
(if (= card "4")
    (message "This ZZ9000 is running in Zorro II mode.\n\n"
             "PrismRTG can show pictures on it, but the card's blitter and mouse pointer "
             "are only supported in Zorro III mode, and Zorro II mode has not been "
             "tested. Picasso96 is the safer choice on this machine for now."))

; ---- an installed Picasso96 ----------------------------------------------
; PrismSetup DETECT listed what starts Picasso96 at boot: its monitor files in
; DEVS:Monitors and its Picasso96API.library. With those in place PrismRTG
; does not start (PrismD checks), so the choice is the user's, made before
; anything is copied.
(if (<> p96n "0")
    (
        (set p96what
            (askchoice
                (prompt "Picasso96 is installed on this Amiga:\n\n" p96list "\n"
                        "PrismRTG and Picasso96 cannot both be active. What should the "
                        "installer do with these files?")
                (help "Back it up: the files listed are MOVED to the drawer "
                      "SYS:Storage/Picasso96-parked, with a note of where each one came "
                      "from. Nothing is deleted. The rest of Picasso96 (its drawer, its "
                      "preferences, LIBS:Picasso96) stays where it is and does nothing "
                      "without them. Removing PrismRTG with this installer moves them "
                      "back.\n\n"
                      "Leave it: nothing of Picasso96 is touched. PrismRTG is installed "
                      "but does NOT start while these files are there - the Amiga goes "
                      "on using Picasso96 exactly as before. Run this installer again "
                      "when you want to switch.\n\n"
                      "To stop here without installing anything, use Abort Install.")
                (choices "Back it up and switch to PrismRTG"
                         "Leave it (PrismRTG stays off)")
                (default 0)))
        (if (= p96what 0)
            (
                (run "PrismSetup >NIL: P96PARK")
                (run "PrismSetup >NIL: DETECT")
                (if (<> (getenv "PrismP96") "0")
                    (
                        (set p96left 1)
                        (message "Not all of Picasso96 could be moved:\n\n"
                                 (getenv "PrismP96List") "\n"
                                 "PrismRTG will be installed but will not start until these "
                                 "are out of the way (move them by hand, then reboot).")
                    ))
            )
            (set p96left 1))
    ))

; ---- the programs --------------------------------------------------------
(copyfiles (prompt "The PrismRTG driver")
           (source "PrismD") (dest "C:")
           (help @copyfiles-help))
(if (not (exists "LIBS:Prism")) (makedir "LIBS:Prism"))
(copyfiles (source "Drivers") (dest "LIBS:Prism") (all) (nogauge))
(copyfiles (source "PrismSetup") (dest "C:") (nogauge))
(copyfiles (source "PrismProbe") (dest "C:") (nogauge))
(if (exists "PrismImport")
    (copyfiles (source "PrismImport") (dest "C:") (nogauge)))
(if (exists "PrismUpdate")
    (copyfiles (source "PrismUpdate") (dest "C:") (nogauge)))
(copyfiles (source "Prism") (dest mon) (infos) (nogauge))
(copyfiles (source "PrismPrefs") (dest "SYS:Prefs") (infos) (nogauge))
; translations of the tools' texts, when the package has any
(if (exists "Catalogs")
    (copyfiles (source "Catalogs") (dest "LOCALE:Catalogs") (all) (nogauge)))
; an archive unpacked by some tools loses the "executable" bit
(run "Protect >NIL: C:PrismD +e")
(run "Protect >NIL: C:PrismSetup +e")
(run "Protect >NIL: C:PrismProbe +e")
(run "Protect >NIL: C:PrismUpdate +e")
(run "Protect >NIL: C:PrismImport +e")
(run (cat "Protect >NIL: \"" (tackon mon "Prism") "\" +e"))
(run "Protect >NIL: SYS:Prefs/PrismPrefs +e")
(if (= wipe 1)
    (run "Delete >NIL: ENVARC:Prism.prefs ENV:Prism.prefs QUIET"))
(if (not (exists "ENVARC:Prism.prefs"))
    (run "SYS:Prefs/PrismPrefs >NIL: SAVE"))
; a card through its Picasso96 driver: PrismD's P96 adapter is told which one
; (looked up again: Picasso96's monitor may have been backed up just now)
(if (= card "12")
    (
        (run "C:PrismSetup >NIL: DETECT")
        (if (<> (getenv "PrismP96Card") "")
            (run (cat "C:PrismSetup >NIL: P96CARD=\"" (getenv "PrismP96Card") "\" P96MONITOR=\""
                      (tackon (getenv "PrismP96MonDir") (getenv "PrismP96Mon")) "\"")))
    ))
; a Startup-Sequence whose LoadMonDrvs loads only the monitors it names
; (Caffeine OS) never starts PrismRTG's: PrismSetup adds a few lines after
; it, keeping the old file as S:Startup-Sequence.before-prism
(set ssmsg "")
(if (= (run "C:PrismSetup >NIL: STARTUP=CHECK") 10)
    (if (askbool
            (prompt "This Amiga's S:Startup-Sequence loads only the monitors it names "
                    "(LoadMonDrvs \"...\"), so PrismRTG would never start.\n\n"
                    "Add the lines that start it?")
            (help "A few lines go in after the monitors are loaded: IF EXISTS "
                  "DEVS:Monitors/Prism, start it, EndIF, between ;BEGIN PrismRTG and "
                  ";END PrismRTG. The file as it is now is kept as "
                  "S:Startup-Sequence.before-prism. Removing PrismRTG with this "
                  "installer takes the lines out again.")
            (default 1))
        (if (= (run "C:PrismSetup >NIL: STARTUP=ADD") 0)
            (set ssmsg "\n\nS:Startup-Sequence now starts PrismRTG (the old one is S:Startup-Sequence.before-prism).")
            (set ssmsg "\n\nS:Startup-Sequence could not be changed: PrismRTG will not start at boot until DEVS:Monitors/Prism is run from it."))
        (set ssmsg "\n\nS:Startup-Sequence was left alone: PrismRTG will not start at boot until DEVS:Monitors/Prism is run from it.")))

; the screen sizes and depths switched on in Picasso96, on a first install
; (PrismImport; added to PrismRTG's own, which stay on)
(if (and fresh (exists "C:PrismImport")
         (or (exists "DEVS:Picasso96Settings") (exists "ENVARC:Picasso96Settings")))
    (if (askbool
            (prompt "Picasso96's settings are on this Amiga. Switch on the same screen "
                    "sizes and depths in PrismRTG?")
            (help "PrismImport reads Picasso96's settings file and switches on every "
                  "size and depth that was switched on there (sizes PrismRTG does not "
                  "have become custom sizes, up to four). PrismRTG's own sizes stay on "
                  "as well. Picasso96's settings are only read, never changed. You can "
                  "run C:PrismImport again later, and PrismPrefs changes the list.")
            (default 1))
        (run "C:PrismImport >NIL:")))

; Prism's own Picasso96API.library: the working one is inside PrismD; this
; small file is for programs that look for it in LIBS:. Ours is a few hundred
; bytes - a bigger file of that name is Picasso96's and is kept, not deleted.
(if (exists plib)
    (if (> (getsize plib) 2000)
        (if (not (exists pkeep))
            (run (cat "Rename >NIL: \"" plib "\" \"" pkeep "\"")))))
(copyfiles (source "Picasso96API.library") (dest "LIBS:") (nogauge))
(complete 50)

(complete 70)

; ---- the Workbench screen ------------------------------------------------
; slots (prefs.h): depth * 8 + size; sizes 640x400, 640x480, 800x600, 1024x768...
; (a first install only: an update leaves the Workbench screen alone)
(if (and fresh (= p96left 0))
    (
        (set wb
            (askchoice
                (prompt "Which screen should Workbench open on after the reboot?")
                (help "A PrismRTG screen is shown by the graphics card. 800 x 600 works on "
                      "practically every monitor. You can change it at any time in "
                      "Prefs/ScreenMode (the PRISM: modes), and Prefs/PrismPrefs has a "
                      "Test button that shows a mode for ten seconds before you commit "
                      "to it.\n\n"
                      "\"Leave it as it is\" keeps today's Workbench screen: choose a "
                      "PRISM: mode in Prefs/ScreenMode yourself later.\n\n"
                      "Today's setting is kept in " sback " and comes back when PrismRTG "
                      "is removed (Caffeine OS's per-machine copies, screenmode.prefs.UAE "
                      "and .PI, are set and kept the same way).")
                (choices "Prism 640 x 480, 256 colours"
                         "Prism 800 x 600, 256 colours"
                         "Prism 800 x 600, 16-bit"
                         "Prism 1024 x 768, 16-bit"
                         "Leave it as it is")
                (default wbdef)))
        (if (< wb 4)
            (
                (if (and (exists smode) (not (exists sback)))
                    (run (cat "Copy >NIL: \"" smode "\" \"" sback "\" CLONE")))
                ; by ModeID (depth slot, size slot): slot numbers move when sizes are added
                (if (= wb 0) (run "C:PrismSetup >NIL: WBID=0001"))
                (if (= wb 1) (run "C:PrismSetup >NIL: WBID=0002"))
                (if (= wb 2) (run "C:PrismSetup >NIL: WBID=0102"))
                (if (= wb 3) (run "C:PrismSetup >NIL: WBID=0103"))
            ))
    ))

; the package drawer came with a plain drawer icon so it shows when unpacked;
; from now on it has this Workbench's own (ENV:Sys/def_drawer.info). Not on
; the install floppy: a disk root has no drawer icon, and it may be locked.
(set pkgdir (expandpath ""))
(if (and (exists "ENV:Sys/def_drawer.info" (noreq))
         (<> (substr pkgdir (- (strlen pkgdir) 1) 1) ":"))
    (if (exists (cat pkgdir ".info") (noreq))
        (run (cat "Copy >NIL: ENV:Sys/def_drawer.info \"" pkgdir ".info\""))))
(complete 100)

(if (= p96left 1)
    (exit "PrismRTG is installed, but Picasso96 is still in place, so PrismRTG will "
          "NOT start: this Amiga goes on using Picasso96.\n\n"
          "Run Install_PrismRTG again and choose \"Back it up\" when you want to switch."
          (quiet)))
(exit (if fresh "PrismRTG is installed" "PrismRTG is updated")
      (if (<> cardname "") (cat " for the " cardname) "")
      "." ssmsg "\n\n"
      "Reboot to start it.\n\n"
      "If Workbench comes back on a small Amiga screen, PrismRTG did not start: "
      "Prefs/PrismPrefs says why on its bottom line. Change what it says and "
      "reboot again; if that doesn't help, double-click PrismProbe here for a "
      "report to send.\n\n"
      "If the screen stays dark or looks wrong: hold the LEFT MOUSE BUTTON while "
      "booting and PrismRTG does not start. A start that hangs is also skipped by "
      "itself on the next boot. Then use Prefs/PrismPrefs to change the modes."
      (quiet))      ; no "can be found in your ... drawer" page: nothing lives in one drawer
